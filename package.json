{
  "name": "tixchat-frontend",
  "version": "1.0.0",
  "description": "TixChat - Realtime Chat Application Frontend",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright test --reporter=json --output=reports/playwright-artifacts > reports/module1-playwright-results.json",
    "report:test": "node scripts/generateModule1Report.js",
    "test:uc": "playwright test tests/real-use-cases.spec.js",
    "test:uc:report": "playwright test tests/real-use-cases.spec.js --reporter=json --output=reports/real-use-cases-playwright-artifacts > reports/real-use-cases-results.json",
    "report:uc": "node scripts/generateRealUseCasesReport.js"
  },
  "dependencies": {
    "amazon-chime-sdk-js": "^3.30.0",
    "axios": "^1.3.4",
    "maplibre-gl": "^5.24.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.10.1",
    "react-router-dom": "^6.11.0",
    "socket.io-client": "^4.6.1",
    "zustand": "^4.3.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-react": "^3.1.0",
    "eslint": "^8.40.0",
    "eslint-plugin-react": "^7.32.2",
    "vite": "^4.2.0"
  }
}
